<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdslCase01</RootNamespace>
    <AssemblyName>Case01</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- SQLite embebido como substrato real del caso — sin contenedor extra.
         La versión 10.0.13 alinea con TargetFramework net10.0. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>
</Project>
